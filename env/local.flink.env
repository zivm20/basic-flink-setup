# Job settings as seen FROM Flink containers (Docker Desktop -> host services)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=events
KAFKA_GROUP_ID=flink-iceberg-lab
KAFKA_STARTING_OFFSETS=earliest

ICEBERG_CATALOG_NAME=iceberg
ICEBERG_JDBC_URI=jdbc:postgresql://postgres:5432/iceberg_db
ICEBERG_JDBC_USER=postgres
ICEBERG_JDBC_PASSWORD=postgres
ICEBERG_WAREHOUSE=s3://warehouse-2
ICEBERG_NAMESPACE=lake
ICEBERG_IO_IMPL=org.apache.iceberg.aws.s3.S3FileIO

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=password
S3_PATH_STYLE_ACCESS=true
S3_REGION=us-east-1

# Also expose standard AWS env vars for the SDK / S3FileIO
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password
AWS_REGION=us-east-1
AWS_EC2_METADATA_DISABLED=true

FLINK_CHECKPOINT_INTERVAL_MS=10000
FLINK_PARALLELISM=1
