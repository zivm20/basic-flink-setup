# Same job pointed at on-prem Kafka + JDBC catalog + S3
KAFKA_BOOTSTRAP_SERVERS=kafka.example.internal:9092
KAFKA_TOPIC=events
KAFKA_GROUP_ID=flink-iceberg-lab
KAFKA_STARTING_OFFSETS=earliest

ICEBERG_CATALOG_NAME=iceberg
ICEBERG_JDBC_URI=jdbc:postgresql://postgres.example.internal:5432/iceberg
ICEBERG_JDBC_USER=
ICEBERG_JDBC_PASSWORD=
ICEBERG_WAREHOUSE=s3://warehouse
ICEBERG_NAMESPACE=lake
ICEBERG_IO_IMPL=org.apache.iceberg.aws.s3.S3FileIO

S3_ENDPOINT=https://s3.example.internal
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE_ACCESS=true
S3_REGION=us-east-1

FLINK_CHECKPOINT_INTERVAL_MS=10000
FLINK_PARALLELISM=1



